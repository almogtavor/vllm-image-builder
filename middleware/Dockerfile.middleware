FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

LABEL org.opencontainers.image.source=https://github.ibm.com/AICoOptimization/kvcache-bench
LABEL org.opencontainers.image.description="Spans middleware for vLLM"

WORKDIR /app

ENV HOME=/tmp
ENV MIDDLEWARE_CONFIG_PATH=/app/middleware_config.yaml

RUN uv pip install --system --no-cache-dir \
    fastapi \
    uvicorn[standard] \
    openai \
    pyyaml \
    pydantic \
    httpx \
    transformers \
    sentencepiece \
    tokenizers

COPY middleware/ /app/
# Shared SGLang client (local tokenize + native /generate + qwen tool parse) used
# when BACKEND_KIND=sglang. middleware.py adds /workspace/sglang to sys.path; mirror
# that here so the import resolves in this image too.
COPY sglang/ /workspace/sglang/

RUN mkdir -p /tmp/middleware_logs && chmod -R 0777 /tmp/middleware_logs

EXPOSE 8080

ENTRYPOINT ["uvicorn", "middleware:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
